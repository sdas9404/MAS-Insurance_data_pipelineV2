<?xml version='1.0' encoding='utf-8'?>
<configuration>
  <input>
    <net-file value="network/london_filtered.net.xml" />
    <route-files value="routes/run_001_900.rou.xml" />
    <additional-files value="network/london.poly.xml" />
  </input>
  <output>
    <tripinfo-output value="data/raw/run_001/tripinfo.xml" />
    <collision-output value="data/raw/run_001/collisions.xml" />
    <lanechange-output value="data/raw/run_001/lanechanges.xml" />
    <tripinfo-output.write-unfinished value="true" />
  </output>
  <time>
    <begin value="0" />
    <end value="36000" />
    <step-length value="0.2" />
  </time>
  <processing>
    <collision.action value="warn" />
    <collision.check-junctions value="true" />
  </processing>
  <report>
    <duration-log.statistics value="true" />
  </report>
</configuration>